# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/orderia

# Orderia API authentication. JSON map: API key -> merchant ID.
# Example: {"ord_live_replace_me":"merchant_cuid"}
ORDERIA_API_KEYS={"ord_live_replace_me":"merchant_cuid"}

# IMIR / EcoTrack
IMIR_API_BASE_URL=https://YOUR-IMIR-API-HOST
IMIR_API_TOKEN=YOUR_BEARER_TOKEN
# Exact paths from the IMIR API documentation/account:
IMIR_CREATE_PARCEL_PATH=
IMIR_TRACKING_PATH=

# HMAC secret used to sign the dashboard session cookie. Generate a long random value.
ORDERIA_SESSION_SECRET=replace_with_a_long_random_secret
